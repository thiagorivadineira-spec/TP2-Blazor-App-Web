@page "/clientes"
@rendermode InteractiveServer
@using TrabajoPractico2Web.Models
@using TrabajoPractico2Web.DAL.Services
@inject ClienteService ClienteService

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Gestión de Clientes</h2>
        <a href="/clientes/formulario" class="btn btn-success">Nuevo Cliente</a>
    </div>

    @if (clientes == null)
    {
        <p><em>Cargando...</em></p>
    }
    else
    {
        <table class="table table-striped table-hover border">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Email</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cliente in clientes)
                {
                    <tr>
                        <td>@cliente.Id</td>
                        <td>@cliente.Nombre</td>
                        <td>@cliente.Apellido</td>
                        <td>@cliente.Email</td>
                        <td>
                            <a href="/clientes/formulario/@cliente.Id" class="btn btn-sm btn-primary">Editar</a>
                            <button class="btn btn-sm btn-danger" @onclick="() => Eliminar(cliente.Id)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<Cliente>? clientes;

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }

    private async Task CargarClientes()
    {
        clientes = await ClienteService.GetClientesAsync();
    }

    private async Task Eliminar(int id)
    {
        await ClienteService.DeleteClienteAsync(id);
        await CargarClientes();
    }
}