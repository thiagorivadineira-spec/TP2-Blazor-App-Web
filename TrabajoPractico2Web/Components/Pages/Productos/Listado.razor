@page "/productos"
@rendermode InteractiveServer
@using TrabajoPractico2Web.Models
@using TrabajoPractico2Web.DAL.Services
@inject ProductoService ProductoService

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Gestión de Productos</h2>
        <a href="/productos/formulario" class="btn btn-success">Nuevo Producto</a>
    </div>

    @if (productos == null)
    {
        <p><em>Cargando...</em></p>
    }
    else
    {
        <table class="table table-striped table-hover border">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prod in productos)
                {
                    <tr>
                        <td>@prod.Id</td>
                        <td>@prod.Nombre</td>
                        <td>$@prod.Precio</td>
                        <td>@prod.Stock</td>
                        <td>
                            <a href="/productos/formulario/@prod.Id" class="btn btn-sm btn-primary">Editar</a>
                            <button class="btn btn-sm btn-danger" @onclick="() => Eliminar(prod.Id)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<Producto>? productos;

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
    }

    private async Task CargarProductos()
    {
        productos = await ProductoService.GetProductosAsync();
    }

    private async Task Eliminar(int id)
    {
        await ProductoService.DeleteProductoAsync(id);
        await CargarProductos();
    }
}